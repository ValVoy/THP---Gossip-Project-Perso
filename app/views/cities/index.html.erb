<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-white">Nos Villes 📍</h1>
    <p class="text-muted">Découvre les potins quartier par quartier</p>
  </div>

  <div class="row g-4">
    <% @cities.each do |city| %>
      <div class="col-md-4 col-lg-3">
        <%= link_to city_path(city.id), class: "text-decoration-none" do %>
          <div class="card h-100 border-secondary shadow-sm hover-city-card" style="background-color: #161b22; transition: 0.3s;">
            <div class="card-body text-center p-4">
              <div class="fs-1 mb-3">🏢</div>
              <h5 class="fw-bold text-primary mb-1"><%= city.name %></h5>
              <p class="text-muted small mb-3"><%= city.zip_code %></p>
              <span class="badge bg-dark border border-secondary text-secondary rounded-pill">
                <%= city.users.joins(:gossips).count %> potins
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .hover-city-card:hover {
    transform: translateY(-10px);
    border-color: #58a6ff !important;
    background-color: #1c2128 !important;
  }
</style>
<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
  <head>
    <title>GossipProject | Dark Edition</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_importmap_tags %>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      body { font-family: 'Inter', sans-serif; background-color: #0d1117; color: #e6edf3; overflow-y: scroll; }
      .navbar { background-color: rgba(22, 27, 34, 0.9) !important; backdrop-filter: blur(12px); border-bottom: 1px solid #30363d; min-height: 70px; }
      .text-gradient { background: linear-gradient(90deg, #58a6ff, #bc8cff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .dropdown-menu { background-color: #161b22; border: 1px solid #30363d; padding: 0.5rem 0; border-radius: 12px; }
      .dropdown-item, .btn-logout-custom { display: block; width: 100%; padding: 0.25rem 1.5rem; clear: both; font-weight: 400; text-align: inherit; text-decoration: none; white-space: nowrap; background-color: transparent; border: 0; line-height: 1.5; font-size: 1rem; cursor: pointer; color: #e6edf3; }
      .dropdown-item:hover, .btn-logout-custom:hover { background-color: #30363d; color: #58a6ff; }
      .btn-logout-custom:hover { color: #ff7b72 !important; }
      .card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; }
      .alert { border-radius: 12px; border: none; }

      /* Ajustements spécifiques Mobile */
      @media (max-width: 991.98px) { 
        .navbar-collapse { 
          background-color: #161b22; 
          margin-top: 10px; 
          padding: 15px; 
          border-radius: 15px; 
          border: 1px solid #30363d; 
        } 
        .nav-link { 
          padding: 12px 5px !important; 
          border-bottom: 1px solid rgba(255,255,255,0.05); 
        } 
        .navbar-nav { align-items: flex-start !important; }
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg sticky-top">
      <div class="container">
        <%= link_to "GossipProject 🗣️", root_path, class: "navbar-brand fw-bold text-gradient" %>
        
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            
            <%# --- LINKS VISIBLES UNIQUEMENT SUR MOBILE (< 992px) --- %>
            <div class="d-lg-none w-100">
              <li class="nav-item"><%= link_to "🏠 Accueil", root_path, class: "nav-link text-white" %></li>
              <% if logged_in? %>
                <li class="nav-item"><%= link_to "👤 Mon Profil", user_path(current_user.id), class: "nav-link text-info fw-bold" %></li>
                <li class="nav-item"><%= link_to "✍️ Créer un potin", new_gossip_path, class: "nav-link text-primary fw-bold" %></li>
                <li class="nav-item mt-2">
                  <%= button_to session_path(current_user.id), method: :delete, class: "btn btn-outline-danger btn-sm w-100 text-start px-3 py-2 rounded-3" do %>
                    🚪 Déconnexion
                  <% end %>
                </li>
              <% else %>
                <li class="nav-item"><%= link_to "🔑 Se connecter", new_session_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "📝 S'inscrire", new_user_path, class: "nav-link text-info" %></li>
              <% end %>
              <hr class="text-secondary">
              <li class="nav-item"><%= link_to "👥 L'Équipe", team_path, class: "nav-link small opacity-75" %></li>
              <li class="nav-item"><%= link_to "📧 Contact", contact_path, class: "nav-link small opacity-75" %></li>
            </div>

            <%# --- DROPDOWN VISIBLE UNIQUEMENT SUR DESKTOP (>= 992px) --- %>
            <li class="nav-item dropdown d-none d-lg-block">
              <a class="nav-link dropdown-toggle btn btn-outline-secondary px-4 rounded-pill text-white" href="#" role="button" data-bs-toggle="dropdown">
                <%= logged_in? ? "Salut, #{current_user.first_name} !" : "Menu" %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2">
                <li><%= link_to "🏠 Accueil", root_path, class: "dropdown-item" %></li>
                <li><%= link_to "📜 Tous les potins", gossips_path, class: "dropdown-item" %></li>
                <li><%= link_to "📍 Villes", cities_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider border-secondary"></li>
                <% if logged_in? %>
                  <li><%= link_to "👤 Mon Profil", user_path(current_user.id), class: "dropdown-item fw-bold text-info" %></li>
                  <li><%= link_to "✍️ Créer un potin", new_gossip_path, class: "dropdown-item fw-bold text-primary" %></li>
                  <li><hr class="dropdown-divider border-secondary"></li>
                  <li>
                    <%= button_to session_path(current_user.id), method: :delete, class: "btn-logout-custom", form: { class: "m-0 p-0" } do %>
                      🚪 Se déconnecter
                    <% end %>
                  </li>
                <% else %>
                  <li><%= link_to "🔑 Se connecter", new_session_path, class: "dropdown-item" %></li>
                  <li><%= link_to "📝 S'inscrire", new_user_path, class: "dropdown-item fw-bold text-info" %></li>
                <% end %>
                
                <%# --- ON RE-AJOUTE ICI POUR LA VERSION DESKTOP --- %>
                <li><hr class="dropdown-divider border-secondary"></li>
                <li><%= link_to "👥 L'Équipe", team_path, class: "dropdown-item" %></li>
                <li><%= link_to "📧 Contact", contact_path, class: "dropdown-item" %></li>
              </ul>
            </li>

          </ul>
        </div>
      </div>
    </nav>

    <div class="container py-4">
      <% flash.each do |type, msg| %>
        <div class="alert alert-<%= type == 'success' ? 'success' : 'danger' %> shadow-sm"><%= msg %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
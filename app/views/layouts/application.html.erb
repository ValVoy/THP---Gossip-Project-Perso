<!DOCTYPE html>
<html>
  <head>
    <title>The Gossip Project</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand" href="/">Gossip Project</a>
        <div class="navbar-nav">
          <%= link_to "Accueil", root_path, class: "nav-link" %>
          <%= link_to "L'équipe", team_path, class: "nav-link" %>
          <%= link_to "Contact", contact_path, class: "nav-link" %>
          <%= link_to "Nouveau Potin", new_gossip_path, class: "btn btn-outline-success ms-lg-3" %>
        </div>
      </div>
    </nav>

    <div class="container mt-3">
      <%# Bloc des alertes flash %>
      <% flash.each do |type, message| %>
        <%# On adapte les types flash de Rails (success/danger) %>
        <% alert_class = type == "success" ? "success" : "danger" %>
        <div class="alert alert-<%= alert_class %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

    <%# Le contenu de tes vues s'affichera ici %>
    <%= yield %>
  </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
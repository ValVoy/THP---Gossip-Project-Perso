<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
  <head>
    <title>GossipProject | Dark Edition</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      body { font-family: 'Inter', sans-serif; background-color: #0d1117; color: #e6edf3; overflow-y: scroll; }
      .navbar { background-color: rgba(22, 27, 34, 0.9) !important; backdrop-filter: blur(12px); border-bottom: 1px solid #30363d; min-height: 70px; }
      @media (max-width: 991.98px) {
        .navbar-collapse.show { background-color: #161b22; margin: 0 -1rem; padding: 1rem; border-top: 1px solid #30363d; margin-top: 0.5rem; }
        .nav-link { padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      }
      .card { background-color: #161b22; border: 1px solid #30363d; border-radius: 12px; }
      .text-gradient { background: linear-gradient(90deg, #58a6ff, #bc8cff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .dropdown-menu { background-color: #161b22; border: 1px solid #30363d; }
      .dropdown-item { color: #e6edf3; }
      .dropdown-item:hover { background-color: #30363d; color: #58a6ff; }
      .jumbotron, .bg-white { background-color: #161b22 !important; color: #e6edf3 !important; border: 1px solid #30363d !important; }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg sticky-top">
      <div class="container">
        <%= link_to "GossipProject 🗣️", root_path, class: "navbar-brand fw-bold text-gradient" %>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            
            <%# --- MENU MOBILE --- %>
            <li class="nav-item d-lg-none"><%= link_to "🏠 Accueil", root_path, class: "nav-link" %></li>
            <li class="nav-item d-lg-none"><%= link_to "📜 Tous les potins", gossips_path, class: "nav-link" %></li>
            
            <% if logged_in? %>
              <li class="nav-item d-lg-none text-primary fw-bold"><%= link_to "✍️ Créer un potin", new_gossip_path, class: "nav-link" %></li>
              <li class="nav-item d-lg-none"><%= link_to "🚪 Déconnexion", session_path(current_user.id), data: { turbo_method: :delete }, class: "nav-link text-danger" %></li>
            <% else %>
              <li class="nav-item d-lg-none"><%= link_to "🔑 Se connecter", new_session_path, class: "nav-link" %></li>
              <li class="nav-item d-lg-none"><%= link_to "📝 S'inscrire", new_user_path, class: "nav-link text-info" %></li>
            <% end %>

            <%# --- MENU DESKTOP --- %>
            <li class="nav-item dropdown d-none d-lg-block">
              <a class="nav-link dropdown-toggle btn btn-outline-secondary px-4 rounded-pill text-white" href="#" role="button" data-bs-toggle="dropdown">
                <% if logged_in? %>
                  Salut, <%= current_user.first_name %> !
                <% else %>
                  Menu
                <% end %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2">
                <% if logged_in? %>
                  <li><%= link_to "🏠 Accueil", root_path, class: "dropdown-item" %></li>
                  <li><%= link_to "📜 Tous les potins", gossips_path, class: "dropdown-item" %></li>
                  <li><hr class="dropdown-divider border-secondary"></li>
                  <li><%= link_to "✍️ Créer un potin", new_gossip_path, class: "dropdown-item fw-bold text-primary" %></li>
                  <li><hr class="dropdown-divider border-secondary"></li>
                  <li><%= link_to "🚪 Se déconnecter", session_path(current_user.id), data: { turbo_method: :delete }, class: "dropdown-item text-danger" %></li>
                <% else %>
                  <li><%= link_to "🔑 Se connecter", new_session_path, class: "dropdown-item" %></li>
                  <li><%= link_to "📝 S'inscrire", new_user_path, class: "dropdown-item fw-bold text-info" %></li>
                  <li><hr class="dropdown-divider border-secondary"></li>
                  <li><%= link_to "👥 L'Équipe", team_path, class: "dropdown-item" %></li>
                  <li><%= link_to "📧 Contact", contact_path, class: "dropdown-item" %></li>
                <% end %>
              </ul>
            </li>

          </ul>
        </div>
      </div>
    </nav>

    <div class="container py-4">
      <% flash.each do |type, msg| %>
        <div class="alert alert-<%= type == 'success' ? 'success' : 'danger' %> border-0 shadow-sm"><%= msg %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
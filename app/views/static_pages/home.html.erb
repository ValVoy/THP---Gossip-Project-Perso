<div class="py-5 text-center shadow-lg rounded-5 mb-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155;">
  <h1 class="display-2 fw-bold mb-3 text-gradient">Breaking <span class="text-white">News</span></h1>
  <p class="text-secondary fs-4 px-3">Découvrez les derniers secrets croustillants de la communauté.</p>
  <div class="mt-4">
    <%= link_to "Découvrir tous les potins", gossips_path, class: "btn btn-primary btn-lg rounded-pill px-5 shadow" %>
  </div>
</div>

<h3 class="mb-4 d-flex align-items-center"><span class="me-3">🔥</span> Les dernières pépites</h3>

<div class="row g-4 mb-5">
  <% @gossips.each do |gossip| %>
    <div class="col-md-4">
      <div class="card h-100 p-4 border-0 shadow-lg">
        <div class="card-body d-flex flex-column">
          <h3 class="fw-bold mb-3 h4 text-primary"><%= gossip.title %></h3>
          <p class="text-secondary mb-4 flex-grow-1"><%= truncate(gossip.content, length: 120) %></p>
          <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-secondary">
            <small class="text-muted">✍️ <%= gossip.user.first_name %></small>
            <%= link_to "Lire la suite", gossip_path(gossip.id), class: "btn btn-sm btn-outline-primary rounded-pill px-3" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
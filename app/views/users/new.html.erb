<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-lg p-5 rounded-5 border-0" style="background-color: #161b22; border: 1px solid #30363d !important;">
        
        <h2 class="text-white fw-bold mb-4 text-center">Rejoindre l'élite 🕵️‍♂️</h2>

        <% if @user.errors.any? %>
          <div class="alert alert-danger rounded-4 border-0">
            <ul class="mb-0 small">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_for @user do |f| %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :first_name, "Prénom", class: "text-muted small fw-bold text-uppercase" %>
              <%= f.text_field :first_name, class: "form-control bg-dark text-white border-secondary rounded-3" %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :last_name, "Nom", class: "text-muted small fw-bold text-uppercase" %>
              <%= f.text_field :last_name, class: "form-control bg-dark text-white border-secondary rounded-3" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Email", class: "text-muted small fw-bold text-uppercase" %>
            <%= f.email_field :email, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="mb-3">
            <%= f.label :age, "Âge", class: "text-muted small fw-bold text-uppercase" %>
            <%= f.number_field :age, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Mot de passe", class: "text-muted small fw-bold text-uppercase" %>
            <%= f.password_field :password, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmation", class: "text-muted small fw-bold text-uppercase" %>
            <%= f.password_field :password_confirmation, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="d-grid mt-4">
            <%= f.submit "Créer mon compte", class: "btn btn-primary btn-lg rounded-pill fw-bold" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
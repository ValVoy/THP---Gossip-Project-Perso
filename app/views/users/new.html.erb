<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-lg p-4 mt-5">
      <div class="card-body">
        <h2 class="text-center fw-bold mb-4 text-gradient">Rejoindre l'aventure</h2>
        <p class="text-center text-muted mb-4">Crée ton compte pour commencer à partager tes potins.</p>

        <%= form_with model: @user, local: true do |f| %>
          
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :first_name, "Prénom", class: "form-label" %>
              <%= f.text_field :first_name, class: "form-control bg-dark text-white border-secondary", placeholder: "Jean" %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :last_name, "Nom", class: "form-label" %>
              <%= f.text_field :last_name, class: "form-control bg-dark text-white border-secondary", placeholder: "Dupont" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Adresse Email", class: "form-label" %>
            <%= f.email_field :email, class: "form-control bg-dark text-white border-secondary", placeholder: "jean@example.com" %>
          </div>

          <div class="row">
            <div class="col-md-4 mb-3">
              <%= f.label :age, "Âge", class: "form-label" %>
              <%= f.number_field :age, class: "form-control bg-dark text-white border-secondary" %>
            </div>
            <div class="col-md-8 mb-3">
               <%= f.label :description, "Bio (optionnel)", class: "form-label" %>
               <%= f.text_area :description, class: "form-control bg-dark text-white border-secondary", rows: 1 %>
            </div>
          </div>

          <hr class="my-4 border-secondary">

          <div class="mb-3">
            <%= f.label :password, "Mot de passe (6 car. min)", class: "form-label" %>
            <%= f.password_field :password, class: "form-control bg-dark text-white border-secondary" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmation du mot de passe", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control bg-dark text-white border-secondary" %>
          </div>

          <div class="d-grid gap-2">
            <%= f.submit "Créer mon compte", class: "btn btn-primary btn-lg rounded-pill fw-bold" %>
          </div>

        <% end %>

        <div class="mt-4 text-center">
          <small class="text-muted">Déjà un compte ? <%= link_to "Se connecter", new_session_path, class: "text-info text-decoration-none" %></small>
        </div>

      </div>
    </div>
  </div>
</div>
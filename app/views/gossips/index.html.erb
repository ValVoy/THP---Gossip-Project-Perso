<h1>Bienvenue sur The Gossip Project !</h1>
<div class="row">
  <% @gossips.each do |gossip| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= gossip.title %></h5>
          <p class="card-text">Auteur : <strong><%= gossip.user.first_name %></strong></p>
          <%= link_to "Voir plus", gossip_path(gossip.id), class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
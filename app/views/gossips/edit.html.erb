<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-lg p-4 rounded-5 border-0" style="background: linear-gradient(145deg, #161b22, #0d1117); border: 1px solid #30363d !important;">
        
        <h1 class="text-white fw-bold mb-4 text-center">Modifier le potin ✏️</h1>

        <%# --- BLOC D'ERREURS --- %>
        <% if @gossip.errors.any? %>
          <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4">
            <h6 class="fw-bold text-dark">Modifications impossibles :</h6>
            <ul class="mb-0 small text-dark">
              <% @gossip.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_tag gossip_path(@gossip.id), method: "patch" do %>
          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Titre</label>
            <%= text_field_tag 'title', @gossip.title, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Contenu</label>
            <%= text_area_tag 'content', @gossip.content, rows: 6, class: "form-control bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Changer le Tag</label>
            <%= select_tag 'tag', options_from_collection_for_select(@all_tags, "id", "title"), class: "form-select bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="d-grid gap-2 mt-5">
            <%= submit_tag "Mettre à jour", class: "btn btn-warning btn-lg rounded-pill fw-bold" %>
            <%= link_to "Retour au potin", gossip_path(@gossip.id), class: "btn btn-link text-muted text-decoration-none" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
<div class="container mt-5">
  <h1>Modifier le potin</h1>

  <% if @gossip.errors.any? %>
    <div class="alert alert-danger">
      <ul><% @gossip.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_tag gossip_path(@gossip.id), method: "patch", data: { turbo: false } do %>
    <div class="mb-3">
      <%= label_tag :title, "Titre" %>
      <%= text_field_tag :title, @gossip.title, class: "form-control" %>
    </div>
    
    <div class="mb-3">
      <%= label_tag :content, "Contenu" %>
      <%= text_area_tag :content, @gossip.content, class: "form-control" %>
    </div>

    <%# --- AJOUT DU SELECT TAG ICI --- %>
    <div class="mb-4">
      <%= label_tag :tag, "Modifier le Tag", class: "form-label" %>
      <%# On pré-sélectionne le tag actuel du potin pour plus de confort %>
      <%= select_tag :tag, options_from_collection_for_select(@all_tags, "id", "title", @gossip.tags.first&.id), class: "form-select" %>
    </div>

    <%= submit_tag "Mettre à jour", class: "btn btn-warning" %>
  <% end %>
</div>
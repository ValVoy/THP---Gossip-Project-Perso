<div class="bg-white p-5 rounded shadow">
  <h1><%= @gossip.title %></h1>
  <p class="text-muted">Publié le <%= @gossip.created_at.strftime("%d/%m/%Y") %></p>
  <p class="lead"><%= @gossip.content %></p>
  <hr>
  <p>Auteur : <%= link_to @gossip.user.first_name, user_path(@gossip.user.id), class: "badge bg-info text-dark text-decoration-none" %></p>
</div>
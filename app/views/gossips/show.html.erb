<div class="jumbotron p-5 mb-4 bg-white border rounded-3 shadow">
  <h1 class="display-4"><%= @gossip.title %></h1>
  <p class="text-muted">Posté le <%= @gossip.created_at.strftime("%d/%m/%Y") %></p>
  <hr class="my-4">
  <p class="lead"><%= @gossip.content %></p>
  
  <p class="mt-4">
    Auteur : 
    <%= link_to @gossip.user.first_name, user_path(@gossip.user.id), class: "btn btn-info btn-sm" %>
  </p>
  
  <p>
    Ville : 
    <%= link_to @gossip.user.city.name, city_path(@gossip.user.city.id), class: "btn btn-outline-info btn-sm" %>
  </p>

  <%= link_to "Retour à l'accueil", root_path, class: "btn btn-secondary mt-3" %>
</div>

<div class="mt-4 mb-5">
  <%= link_to "Modifier ce potin", edit_gossip_path(@gossip.id), class: "btn btn-outline-warning" %>
  
  <%= link_to "Supprimer", gossip_path(@gossip.id), 
      data: { turbo_method: :delete, turbo_confirm: "Es-tu sûr de vouloir supprimer ce potin ?" }, 
      class: "btn btn-danger" %>
</div>

<hr>
<h3>Commentaires (<%= @gossip.comments.count %>)</h3>

<%# Liste des commentaires %>
<div class="list-group mb-4">
  <% @gossip.comments.select(&:persisted?).each do |comment| %>
  <div class="list-group-item">
    <p class="mb-1"><%= comment.content %></p>
    <div class="d-flex justify-content-between align-items-center">
      <small class="text-muted">Par <%= comment.user.first_name %> le <%= comment.created_at.strftime("%d/%m/%Y") %></small>
      <%= link_to "Modifier", edit_gossip_comment_path(@gossip.id, comment.id), class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>
</div>

<%# Formulaire de création %>
<h5>Ajouter un commentaire :</h5>
<%= form_tag gossip_comments_path(@gossip.id), method: "post", data: { turbo: false } do %>
  <div class="form-group mb-3">
    <%= text_area_tag 'content', nil, class: 'form-control', placeholder: "Votre commentaire..." %>
  </div>
  <%= submit_tag "Commenter", class: "btn btn-primary" %>
<% end %>
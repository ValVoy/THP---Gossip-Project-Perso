<div class="jumbotron-modern mb-5 p-4 p-md-5 rounded-5 border shadow-lg" style="background: linear-gradient(145deg, #161b22, #0d1117); border-color: #30363d !important;">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div class="d-flex align-items-center">
      <span class="badge bg-primary-subtle text-primary rounded-pill me-2 px-3">Gossip #<%= @gossip.id %></span>
      <span class="text-secondary small">Posté le <%= @gossip.created_at.strftime("%d %b %Y") %></span>
    </div>

    <div class="d-flex align-items-center bg-dark px-3 py-1 rounded-pill border border-secondary">
      <% if logged_in? %>
        <% pre_like = @gossip.likes.find { |like| like.user_id == current_user.id } %>
        <% if pre_like %>
          <%= button_to '❤️', gossip_like_path(@gossip, pre_like), method: :delete, class: "btn btn-link text-decoration-none p-0 border-0 fs-5" %>
        <% else %>
          <%= button_to '🤍', gossip_likes_path(@gossip), method: :post, class: "btn btn-link text-decoration-none p-0 border-0 fs-5" %>
        <% end %>
      <% else %>
        <span class="fs-5">🤍</span>
      <% end %>
      <span class="ms-2 fw-bold text-secondary"><%= @gossip.likes.count %></span>
    </div>
  </div>
  
  <h1 class="display-5 fw-bold mb-4 text-gradient"><%= @gossip.title %></h1>
  <p class="fs-5 leading-relaxed mb-5 text-secondary"><%= @gossip.content %></p>

  <div class="d-flex flex-wrap gap-3">
    <div class="card p-2 px-3 rounded-4 border-secondary d-flex flex-row align-items-center bg-transparent" style="border: 1px solid #30363d !important;">
      <div class="me-3 fs-3">🧔</div>
      <div>
        <small class="text-muted d-block" style="font-size: 0.7rem;">Auteur</small>
        <%= link_to @gossip.user.first_name, user_path(@gossip.user.id), class: "fw-bold text-decoration-none text-primary" %>
      </div>
    </div>
    <div class="card p-2 px-3 rounded-4 border-secondary d-flex flex-row align-items-center bg-transparent" style="border: 1px solid #30363d !important;">
      <div class="me-3 fs-3">📍</div>
      <div>
        <small class="text-muted d-block" style="font-size: 0.7rem;">Ville</small>
        <%= link_to @gossip.user.city.name, city_path(@gossip.user.city.id), class: "fw-bold text-decoration-none text-primary" %>
      </div>
    </div>
  </div>

  <% if logged_in? && current_user == @gossip.user %>
    <div class="mt-5 pt-4 border-top border-secondary d-flex align-items-center gap-3">
      <%= link_to "Modifier", edit_gossip_path(@gossip.id), class: "btn btn-outline-warning btn-sm px-4 rounded-pill" %>
      
      <%= button_to gossip_path(@gossip.id), 
          method: :delete, 
          form: { data: { turbo_confirm: "Voulez-vous vraiment supprimer ce potin ?" } }, 
          class: "btn btn-link text-danger btn-sm text-decoration-none p-0 border-0",
          style: "line-height: inherit; font-size: 0.875rem;" do %>
        Supprimer
      <% end %>
    </div>
  <% end %>
</div>

<div class="row">
  <div class="col-lg-8 mx-auto">
    <h3 class="fw-bold mb-4 text-white">Commentaires (<%= @gossip.comments.count %>)</h3>

    <% @gossip.comments.select(&:persisted?).each do |comment| %>
      <div class="card mb-3 border-0 rounded-4 shadow-sm" style="background-color: #161b22; border: 1px solid #30363d !important;">
        <div class="card-body p-3">
          <p class="mb-3 text-secondary" style="font-size: 0.95rem;"><%= comment.content %></p>
          
          <div class="d-flex justify-content-between align-items-center border-top border-secondary pt-2">
            <small class="text-muted">Par <span class="text-primary fw-bold"><%= comment.user.first_name %></span></small>
            
            <% if logged_in? && current_user == comment.user %>
              <div class="d-flex align-items-center gap-3">
                <%= link_to "Éditer", edit_gossip_comment_path(@gossip.id, comment.id), class: "text-warning small text-decoration-none opacity-75" %>
                
                <%= button_to gossip_comment_path(@gossip.id, comment.id), 
                    method: :delete, 
                    form: { data: { turbo_confirm: "Supprimer ce commentaire ?" }, class: "d-inline" }, 
                    class: "text-danger small bg-transparent border-0 p-0 text-decoration-none opacity-75" do %>
                  Supprimer
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if logged_in? %>
      <div class="card mt-5 p-4 border-0 rounded-4 shadow-lg" style="background: #161b22; border: 1px solid #30363d !important;">
        <h5 class="mb-3 fw-bold text-white">Ajouter un commentaire</h5>
        <%= form_tag gossip_comments_path(@gossip.id), method: "post" do %>
          <%= text_area_tag 'content', nil, 
              class: 'form-control border-secondary mb-3 shadow-sm text-white', 
              placeholder: "Partage ton avis sur ce potin...", 
              rows: 3, 
              style: "background: #0d1117; border-radius: 12px; resize: none; border: 1px solid #30363d;" %>
          
          <div class="text-end">
            <%= submit_tag "Commenter", class: "btn btn-primary fw-bold rounded-pill px-4 shadow" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center mt-5 py-4 border border-secondary border-dashed rounded-4" style="border-style: dashed !important;">
        <p class="text-muted mb-0">
          Envie de donner ton avis ? 
          <%= link_to "Connecte-toi", new_session_path, class: "text-primary text-decoration-none fw-bold" %> 
          pour commenter !
        </p>
      </div>
    <% end %>
  </div>
</div>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-lg p-4 rounded-5 border-0" style="background: linear-gradient(145deg, #161b22, #0d1117); border: 1px solid #30363d !important;">
        
        <h1 class="text-white fw-bold mb-4 text-center text-gradient">Nouveau Potin 🗣️</h1>

        <%# --- BLOC D'ERREURS --- %>
        <% if @gossip.errors.any? %>
          <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4">
            <h6 class="fw-bold"><%= pluralize(@gossip.errors.count, "erreur") %> empêche(nt) la publication :</h6>
            <ul class="mb-0 small">
              <% @gossip.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_tag gossips_path, method: "post" do %>
          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Titre du potin</label>
            <%= text_field_tag 'title', @gossip.title, class: "form-control bg-dark text-white border-secondary rounded-3", placeholder: "Entre 3 et 14 caractères..." %>
            <div class="form-text text-muted small">Sois percutant, mais bref !</div>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Le contenu croustillant</label>
            <%= text_area_tag 'content', @gossip.content, rows: 6, class: "form-control bg-dark text-white border-secondary rounded-3", placeholder: "Raconte tout..." %>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small text-uppercase fw-bold">Catégorie (Tag)</label>
            <%= select_tag 'tag', options_from_collection_for_select(@all_tags, "id", "title"), class: "form-select bg-dark text-white border-secondary rounded-3" %>
          </div>

          <div class="d-grid gap-2 mt-5">
            <%= submit_tag "Balancer le potin !", class: "btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" %>
            <%= link_to "Annuler", root_path, class: "btn btn-link text-muted text-decoration-none small" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
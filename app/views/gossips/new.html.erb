<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h1 class="text-center mb-4">Partage un nouveau potin ! 🗣️</h1>

      <% if @gossip.errors.any? %>
        <div class="alert alert-danger">
          <p>Le potin n'a pas pu être sauvegardé pour les raisons suivantes :</p>
          <ul>
            <% @gossip.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_tag gossips_path, method: "post", data: { turbo: false } do %>
        
        <div class="mb-3">
          <%= label_tag :title, "Titre du potin", class: "form-label" %>
          <%= text_field_tag :title, @gossip.title, class: "form-control", placeholder: "Un titre percutant (3-14 caractères)" %>
        </div>

        <div class="mb-3">
          <%= label_tag :content, "Le contenu croustillant", class: "form-label" %>
          <%= text_area_tag :content, @gossip.content, class: "form-control", rows: 5, placeholder: "Raconte tout ici..." %>
        </div>

        <%# --- AJOUT DU SELECT TAG ICI --- %>
        <div class="mb-4">
          <%= label_tag :tag, "Choisir un Tag", class: "form-label" %>
          <%= select_tag :tag, options_from_collection_for_select(@all_tags, "id", "title"), class: "form-select" %>
          <small class="text-muted">Donne une catégorie à ton ragot !</small>
        </div>

        <div class="text-center">
          <%= submit_tag "Publier le potin", class: "btn btn-primary btn-lg" %>
        </div>

      <% end %>
    </div>
  </div>
</div>